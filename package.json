{
  "name": "yong-planner",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22.13.0 <23",
    "yarn": "1.22.22"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "build:android": "npx eas-cli@27.2.0 build --platform android",
    "build:ios": "npx eas-cli@27.2.0 build --platform ios",
    "eas-build-pre-install": "corepack enable"
  },
  "dependencies": {
    "expo": "~58.0.22",
    "expo-router": "~58.0.29",
    "expo-sqlite": "~58.0.15",
    "expo-file-system": "~58.0.13",
    "expo-sharing": "~58.0.21",
    "expo-clipboard": "~58.0.4",
    "expo-document-picker": "~58.0.4",
    "expo-crypto": "~58.0.7",
    "expo-constants": "~58.0.14",
    "expo-linking": "~58.0.15",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "zustand": "5.0.16",
    "date-fns": "4.1.0",
    "date-holidays": "3.38.0",
    "expo-dev-client": "~58.0.18"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "eslint": "9.39.1",
    "eslint-config-expo": "~58.0.4",
    "prettier": "3.7.4",
    "husky": "9.1.7",
    "lint-staged": "16.2.7"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,yml,yaml}": [
      "prettier --write"
    ]
  }
}
