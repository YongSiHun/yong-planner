{
  "expo": {
    "name": "용플래너",
    "slug": "yong-planner",
    "version": "1.0.0",
    "scheme": "yongplanner",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yongplanner.app",
      "icon": "./assets/icon-dragon.png"
    },
    "android": {
      "package": "com.yongplanner.app",
      "softwareKeyboardLayoutMode": "resize",
      "allowBackup": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-dragon.png",
        "backgroundColor": "#F7FBFF"
      }
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-document-picker",
      "./plugins/with-dragon-splash.cjs"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/icon-dragon.png",
    "primaryColor": "#1F6EAC",
    "orientation": "default"
  }
}
