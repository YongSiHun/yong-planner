{
  "cli": {
    "version": ">=27.2.0",
    "appVersionSource": "local",
    "promptToConfigurePushNotifications": false
  },
  "build": {
    "base": {
      "node": "26.13.1",
      "credentialsSource": "remote",
      "ios": {
        "image": "macos-tahoe-26.6-xcode-27.2"
      },
      "yarn": "1.22.22"
    },
    "production": {
      "extends": "base",
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production-apk": {
      "extends": "production",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "extends": "base",
      "environment": "preview",
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      }
    },
    "preview-apk": {
      "extends": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "development": {
      "extends": "base",
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "development-apk": {
      "extends": "development"
    },
    "development-aab": {
      "extends": "development",
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleDebug"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
