{
  "cli": {
    "version": "27.2.0",
    "appVersionSource": "local"
  },
  "build": {
    "base": {
      "node": "22.23.2",
      "credentialsSource": "remote"
    },
    "production": {
      "extends": "base",
      "environment": "production",
      "android": {
        "buildType": "app-bundle"
      }
    },
    "production-apk": {
      "extends": "production",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "extends": "base",
      "environment": "preview",
      "distribution": "store",
      "android": {
        "buildType": "app-bundle"
      }
    },
    "preview-apk": {
      "extends": "preview",
      "android": {
        "buildType": "apk"
      }
    },
    "development": {
      "extends": "base",
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "development-apk": {
      "extends": "development"
    },
    "development-aab": {
      "extends": "development",
      "android": {
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleDebug"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
